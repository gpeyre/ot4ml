":"\\operatorname{JS}"},"\\RKHS":{"macro":"\\mathcal{H}"},"\\Krkhs":{"macro":"k"},"\\UW":{"macro":"\\operatorname{UW}"},"\\HW":{"macro":"\\operatorname{HW}"},"\\CW":{"macro":"\\operatorname{CW}"},"\\WFR":{"macro":"\\operatorname{WFR}"},"\\MaxSW":{"macro":"\\operatorname{MaxSW}"},"\\MinSW":{"macro":"\\operatorname{Min\\text{-}SW}"},"\\SRW":{"macro":"\\operatorname{SRW}"},"\\LOT":{"macro":"\\operatorname{LOT}"},"\\WOT":{"macro":"\\operatorname{WOT}"},"\\GW":{"macro":"\\mathcal{GW}"},"\\GWD":{"macro":"\\mathrm{GW}"},"\\Laguerre":{"macro":"\\mathbb{L}"},"\\Qq":{"macro":"\\mathcal{Q}"},"\\Ss":{"macro":"\\mathcal{S}"},"\\De":{"macro":"\\Delta"},"\\XX":{"macro":"\\mathbb{X}"},"\\YY":{"macro":"\\mathbb{Y}"},"\\it":{"macro":"#1^{(\\ell)}"},"\\itt":{"macro":"#1^{(\\ell+1)}"}},"exports":[{"format":"md","filename":"index.md","url":"/ot4ml/myst/_build/html/build/index-461ed557afe9e873b4e58a2ddbc20a67.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Abstract","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IPCYuTOxTZ"}],"identifier":"abstract","label":"Abstract","html_id":"abstract","implicit":true,"key":"ICqTirMG8v"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Modern machine learning repeatedly manipulates probability measures: empirical\ndatasets, generated samples, latent distributions, class-conditional laws,\nparticle systems, parameter distributions of wide networks and attention\npatterns. Optimal transport is useful in this setting because it compares such\nobjects by asking how mass should move. It combines a statistically meaningful\ndiscrepancy with a geometry of interpolation, dual certificates and variational\ndynamics, making OT a common language for losses, generative modeling, domain\nadaptation, robust learning, barycenters, gradient flows and mean-field\ndescriptions of learning algorithms.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"yYgNGpJ3CG"}],"key":"AKjjKL7767"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"This book uses optimal transport as a meeting point between probability, PDEs,\noptimization and statistics, with modern machine learning as the organizing\npressure. In current learning systems, probability distributions are no longer\nperipheral objects: datasets are empirical laws, generators define push-forward\nlaws, samplers solve evolution equations, and large models move information\nthrough populations of particles, parameters and tokens. Comparing and evolving\nsuch distributions has become a central mathematical problem, with particular\nurgency in generative AI. The resulting tensions are both conceptual and\ncomputational: empirical measures are singular, dimensions are large,\nparametrizations are non-convex, and numerical approximations cannot be\nseparated from statistical error. The goal is to expose the OT tools that\norganize these tensions, while keeping their connection to the training and\ndeployment of large models in view.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"fyzDwZB28B"}],"key":"pn8EyXrsoi"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Several books already cover optimal transport from complementary viewpoints.\nThe two-volume monograph of Rachev and Rueschendorf\n","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"LhibHnaqAi"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"rachev1998mass","identifier":"rachev1998mass","children":[{"type":"text","value":"Rachev & Rüschendorf, 1998","key":"cIWyjNWPUy"}],"enumerator":"1","key":"WtRfBJo7EX"},{"type":"cite","kind":"parenthetical","label":"rachev1998mass2","identifier":"rachev1998mass2","children":[{"type":"text","value":"Rachev & Rüschendorf, 1998","key":"Qh8KMknlt5"}],"enumerator":"2","key":"oG8eg8XCKr"}],"key":"G7vAxuhHz5"},{"type":"text","value":" gives a broad probabilistic treatment\nof mass transportation and its applications. Villani’s books\n","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"AtOhhe8UGe"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"Villani03","identifier":"villani03","children":[{"type":"text","value":"Villani, 2003","key":"g3Pye5Bd2b"}],"enumerator":"3","key":"LrAiSXaFO1"},{"type":"cite","kind":"parenthetical","label":"Villani09","identifier":"villani09","children":[{"type":"text","value":"Villani, 2009","key":"MKXrEeoFtP"}],"enumerator":"4","key":"YFDaUr6umi"}],"key":"KO1ekUWzAc"},{"type":"text","value":" are the standard references for the modern\nmathematical theory, from Kantorovich duality to curvature, concentration and\ngeometric analysis. Santambrogio’s text ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"qR1oGRCMUK"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"SantambrogioBook","identifier":"santambrogiobook","children":[{"type":"text","value":"Santambrogio, 2015","key":"kKNbwy13FT"}],"enumerator":"5","key":"pJfYe62dLg"}],"key":"PE40pEqbxF"},{"type":"text","value":" offers a\nconcise applied-mathematics route through the same foundations, with a strong\nemphasis on PDEs and variational arguments, and Ambrosio, Gigli and Savare\n","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"uIeiCw7o40"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ambrosio2006gradient","identifier":"ambrosio2006gradient","children":[{"type":"text","value":"Ambrosio ","key":"ZWqL3liOZD"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"jAVDXJIYHB"}],"key":"v4Au45IjsD"},{"type":"text","value":", 2006","key":"pHVDHafaB7"}],"enumerator":"6","key":"kztFZpkZ62"}],"key":"RQRxjGnAin"},{"type":"text","value":" develop the metric-space theory of gradient\nflows that underlies the dynamical part of the subject. On the computational\nside, Peyre and Cuturi ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"hQ6dnnuCNg"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"peyre2019computational","identifier":"peyre2019computational","children":[{"type":"text","value":"Peyré & Cuturi, 2019","key":"cnwUq24sQi"}],"enumerator":"7","key":"dbNlVcEK0b"}],"key":"OnV21yDs6I"},{"type":"text","value":" provide the reference\naccount of numerical OT, entropic regularization and applications in data\nsciences; Galichon’s book ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"Uzz8ESFTZ3"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"galichon2016optimal","identifier":"galichon2016optimal","children":[{"type":"text","value":"Galichon, 2016","key":"Ri2zcphLP0"}],"enumerator":"8","key":"YIVejPwZSr"}],"key":"itAvTNsO3D"},{"type":"text","value":" explains the economic\nand matching-theoretic viewpoint; and the statistical theory of OT is developed\nin the recent lecture notes of Chewi, Niles-Weed and Rigollet\n","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"biOd5eGtmq"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"weed2025statistical","identifier":"weed2025statistical","children":[{"type":"text","value":"Chewi ","key":"TXAH1RM12j"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"dp9qM0j55L"}],"key":"nBXWZgbs7x"},{"type":"text","value":", 2025",