\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces \emph  {Growth of the Hungarian matching on the planar point clouds of Figure\nobreakspace  {}\ref  {fig:matching-2d-cost-exponent}.} Thick violet segments show the current partial matching $M$, whose cardinality is reported below each panel. Thin translucent segments show the $2n$ lowest-slack unmatched edges, ranked by $s_{i,j}=\mathrm  {C}_{i,j}-\mathrm  {f}_i-\mathrm  {g}_j$; exact zero-slack candidates are slightly stronger. This overlay summarizes the near-tight dual constraints, while the algorithm selects its next edge only across the current alternating-tree cut. In the final panel, all thick edges are dual-tight and form an optimal squared-distance assignment.}}{9}{figure.1.6}\protected@file@percent }
\newlabel{fig:matching-hungarian-progression}{{1.6}{9}{\emph {Growth of the Hungarian matching on the planar point clouds of Figure~\ref {fig:matching-2d-cost-exponent}.} Thick violet segments show the current partial matching $M$, whose cardinality is reported below each panel. Thin translucent segments show the $2n$ lowest-slack unmatched edges, ranked by $s_{i,j}=\C _{i,j}-\fD _i-\gD _j$; exact zero-slack candidates are slightly stronger. This overlay summarizes the near-tight dual constraints, while the algorithm selects its next edge only across the current alternating-tree cut. In the final panel, all thick edges are dual-tight and form an optimal squared-distance assignment}{figure.1.6}{}}
