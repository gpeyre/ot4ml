\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces \emph  {Dual witnesses for integral probability metrics.} The red and blue curves are two one-dimensional probability densities and the violet curve is a normalized optimal dual witness $f^\star _{\alpha ,\beta }$ for the IPM variational problem\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq-dual-norm-cont}\unskip \@@italiccorr )}}. $\Wass  _1$ restricts the slope through Kantorovich--Rubinstein duality\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq-w1-cont}\unskip \@@italiccorr )}}, MMD restricts the RKHS norm as in Proposition\nobreakspace  {}\ref  {prop-kernel-rkhs-dual}, and total variation can saturate pointwise and therefore reacts sharply to signed density differences.}}{87}{figure.6.1}\protected@file@percent }
\newlabel{fig:dualnorms-ipm-witnesses}{{6.1}{87}{\emph {Dual witnesses for integral probability metrics.} The red and blue curves are two one-dimensional probability densities and the violet curve is a normalized optimal dual witness $f^\star _{\alpha ,\beta }$ for the IPM variational problem~\eqref {eq-dual-norm-cont}. $\Wass _1$ restricts the slope through Kantorovich--Rubinstein duality~\eqref {eq-w1-cont}, MMD restricts the RKHS norm as in Proposition~\ref {prop-kernel-rkhs-dual}, and total variation can saturate pointwise and therefore reacts sharply to signed density differences}{figure.6.1}{}}
