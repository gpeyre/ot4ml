\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces \emph  {Optimal transport on the circle by cutting and unfolding.} The red and blue atoms live on two copies of the circle; the denser point clouds make the cyclic ordering visible. Purple segments show the optimal matching and the green radius marks the chosen cut. Once the circle is opened at this angle, the same matching appears as a monotone one-dimensional assignment on the interval, with the two green endpoints identified.}}{6}{figure.1.4}\protected@file@percent }
\newlabel{fig:monge-circle-cut-unfolding}{{1.4}{6}{\emph {Optimal transport on the circle by cutting and unfolding.} The red and blue atoms live on two copies of the circle; the denser point clouds make the cyclic ordering visible. Purple segments show the optimal matching and the green radius marks the chosen cut. Once the circle is opened at this angle, the same matching appears as a monotone one-dimensional assignment on the interval, with the two green endpoints identified}{figure.1.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces \emph  {Optimal assignments between the same two point clouds for four powers of the Euclidean distance.} The source atoms are semi-regular samples in a central disk, while the target atoms are semi-regular samples on a thin annulus; this canonical geometry is reused in later coupling and regularization figures. The feasible set is unchanged, but changing $p$ changes the global organization of the permutation: the concave case $p=1/2$ penalizes long edges only sublinearly and therefore permits longer exchanges, whereas larger powers increasingly suppress the longest edges.}}{6}{figure.1.5}\protected@file@percent }
\newlabel{fig:matching-2d-cost-exponent}{{1.5}{6}{\emph {Optimal assignments between the same two point clouds for four powers of the Euclidean distance.} The source atoms are semi-regular samples in a central disk, while the target atoms are semi-regular samples on a thin annulus; this canonical geometry is reused in later coupling and regularization figures. The feasible set is unchanged, but changing $p$ changes the global organization of the permutation: the concave case $p=1/2$ penalizes long edges only sublinearly and therefore permits longer exchanges, whereas larger powers increasingly suppress the longest edges}{figure.1.5}{}}
