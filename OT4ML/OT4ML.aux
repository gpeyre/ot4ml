\@writefile{lof}{\contentsline {figure}{\numberline {13.7}{\ignorespaces \emph  {Feature information and intrinsic geometry in fused Gromov--Wasserstein.} Here $\mathcal  {X}=\mathcal  {Y}=\mathbb  {R}^2$, $c_{\mathcal  {X},\mathcal  {Y}}(x,y)=|\!| x-y |\!|^2$, and both intrinsic distances are Euclidean. The target is a rotated and translated, slightly perturbed copy of the source; the additional horizontal separation in the drawing is only for readability and is not included in the cost. Thus $\lambda =0$ follows ambient proximity, $\lambda =1$ follows intrinsic geometry, and $\lambda =0.5$ balances the two criteria.}}{294}{figure.13.7}\protected@file@percent }
\newlabel{fig:fused-gromov-feature-geometry}{{13.7}{294}{\emph {Feature information and intrinsic geometry in fused Gromov--Wasserstein.} Here $\X =\Y =\RR ^2$, $c_{\X ,\Y }(x,y)=\norm {x-y}^2$, and both intrinsic distances are Euclidean. The target is a rotated and translated, slightly perturbed copy of the source; the additional horizontal separation in the drawing is only for readability and is not included in the cost. Thus $\lambda =0$ follows ambient proximity, $\lambda =1$ follows intrinsic geometry, and $\lambda =0.5$ balances the two criteria}{figure.13.7}{}}
