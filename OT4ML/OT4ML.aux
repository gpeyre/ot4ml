\@writefile{lof}{\contentsline {figure}{\numberline {15.10}{\ignorespaces \emph  {Brunn--Minkowski through an affine optimal-transport interpolation between two ellipses.} For ellipses, the Brenier map is affine, so the transported support $T_t(A)$ remains an ellipse and its area is computed exactly from the determinant of $(1-t)\mathrm  {Id}+tDT$. The right panel shows that $|T_t(A)|^{1/2}$ lies above the linear interpolation of the endpoint square-root areas, which is the two-dimensional determinant concavity behind the proof of Brunn--Minkowski.}}{359}{figure.15.10}\protected@file@percent }
\newlabel{fig:gradflow-brunn-minkowski-ot}{{15.10}{359}{\emph {Brunn--Minkowski through an affine optimal-transport interpolation between two ellipses.} For ellipses, the Brenier map is affine, so the transported support $T_t(A)$ remains an ellipse and its area is computed exactly from the determinant of $(1-t)\Id +tDT$. The right panel shows that $|T_t(A)|^{1/2}$ lies above the linear interpolation of the endpoint square-root areas, which is the two-dimensional determinant concavity behind the proof of Brunn--Minkowski}{figure.15.10}{}}
