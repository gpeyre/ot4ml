\@writefile{lof}{\contentsline {figure}{\numberline {12.4}{\ignorespaces \emph  {Entropic three-marginal Coulomb transport in one dimension.} The three marginals are the same asymmetric two-Gaussian mixture, and the pairwise cost is $((x_r-x_s)^2+\delta ^2)^{-1/2}$. Each panel shows the $(X_1,X_2)$ marginal of the tensor Sinkhorn solution; the red top strip and blue right strip are the prescribed marginals, while the thin dark curves are the marginals obtained by summing the displayed pairwise plan. Small regularization concentrates the plan away from the collision diagonal, while larger regularization blurs the repulsive arrangement toward the independent reference.}}{249}{figure.12.4}\protected@file@percent }
\newlabel{fig:multimarginal-coulomb-sinkhorn}{{12.4}{249}{\emph {Entropic three-marginal Coulomb transport in one dimension.} The three marginals are the same asymmetric two-Gaussian mixture, and the pairwise cost is $((x_r-x_s)^2+\delta ^2)^{-1/2}$. Each panel shows the $(X_1,X_2)$ marginal of the tensor Sinkhorn solution; the red top strip and blue right strip are the prescribed marginals, while the thin dark curves are the marginals obtained by summing the displayed pairwise plan. Small regularization concentrates the plan away from the collision diagonal, while larger regularization blurs the repulsive arrangement toward the independent reference}{figure.12.4}{}}
