\@writefile{lof}{\contentsline {figure}{\numberline {15.8}{\ignorespaces \emph  {Density-constrained gradient flow under a quadratic attraction.} The one-dimensional flow is computed in quantile variables by explicit Lagrangian descent followed by the isotonic projection enforcing $\partial _s q\geqslant 1/\rho _{\qopname  \relax m{max}}$. Each panel stacks five times vertically, colored from red to blue, using the same vertical density scale in all three panels. The dashed gray line marks the maximal density $\rho _{\qopname  \relax m{max}}$ for the constrained runs. A small cap forces the mass to form a wide saturated block, a medium cap allows a narrower congested region, and the unconstrained flow concentrates freely near the minimizer of $h$.}}{345}{figure.15.8}\protected@file@percent }
\newlabel{fig:gradflow-density-constrained-flow}{{15.8}{345}{\emph {Density-constrained gradient flow under a quadratic attraction.} The one-dimensional flow is computed in quantile variables by explicit Lagrangian descent followed by the isotonic projection enforcing $\partial _s q\geq 1/\rho _{\max }$. Each panel stacks five times vertically, colored from red to blue, using the same vertical density scale in all three panels. The dashed gray line marks the maximal density $\rho _{\max }$ for the constrained runs. A small cap forces the mass to form a wide saturated block, a medium cap allows a narrower congested region, and the unconstrained flow concentrates freely near the minimizer of $h$}{figure.15.8}{}}
