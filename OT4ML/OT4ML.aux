\@writefile{lof}{\contentsline {figure}{\numberline {11.8}{\ignorespaces \emph  {Linear OT coordinates.} Fixing a reference measure $\gamma $ turns each target into a map $T_\alpha $ from $\gamma $ to $\alpha $, or equivalently into the displacement field $T_\alpha -\mathrm  {Id}$. In one dimension this is exactly the quantile parametrization of $\Wass  _2$, so averaging the maps toward a two-component $\alpha $ and a two-component $\beta $ gives the true Wasserstein barycenter. In two dimensions, the first panel shows the reference-to-target maps, computed on dense clouds and displayed on farthest-point subsets, with $\beta $ represented by two Gaussian components. The middle purple panel shows the linearized barycenter obtained by averaging the two maps from $\gamma $. The right purple panel shows the genuine McCann midpoint between $\alpha $ and $\beta $, obtained by solving a direct OT problem between the two target clouds and interpolating at $t=1/2$.}}{227}{figure.11.8}\protected@file@percent }
\newlabel{fig:dualnorms-linear-ot-embedding}{{11.8}{227}{\emph {Linear OT coordinates.} Fixing a reference measure $\gamma $ turns each target into a map $T_\alpha $ from $\gamma $ to $\alpha $, or equivalently into the displacement field $T_\alpha -\Id $. In one dimension this is exactly the quantile parametrization of $\Wass _2$, so averaging the maps toward a two-component $\alpha $ and a two-component $\beta $ gives the true Wasserstein barycenter. In two dimensions, the first panel shows the reference-to-target maps, computed on dense clouds and displayed on farthest-point subsets, with $\beta $ represented by two Gaussian components. The middle purple panel shows the linearized barycenter obtained by averaging the two maps from $\gamma $. The right purple panel shows the genuine McCann midpoint between $\alpha $ and $\beta $, obtained by solving a direct OT problem between the two target clouds and interpolating at $t=1/2$}{figure.11.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Principal components in linear OT coordinates.}{227}{paragraph*.197}\protected@file@percent }
\citation{paty2019subspace}
\citation{peyre2026muon}
\@writefile{lof}{\contentsline {figure}{\numberline {11.9}{\ignorespaces \emph  {One-dimensional linear OT PCA for synthetic two-Gaussian mixtures.} The exact empirical Wasserstein barycenter has quantile \(Q_{\bar  \alpha }=N^{-1}\DOTSI \sumop \slimits@ _iQ_{\alpha _i}\). Each panel shows nine densities with quantiles \(Q_{\bar  \alpha }+a e_k\), including the barycenter at the violet midpoint \(a=0\), with \(a\) increasing from red to blue. The first mode is a common translation and the second changes the separation of the two components. Since every displayed quantile is increasing, these are valid probability laws in exact one-dimensional Wasserstein coordinates.}}{228}{figure.11.9}\protected@file@percent }
\newlabel{fig:linear-ot-1d-pca}{{11.9}{228}{\emph {One-dimensional linear OT PCA for synthetic two-Gaussian mixtures.} The exact empirical Wasserstein barycenter has quantile \(Q_{\bar \alpha }=N^{-1}\sum _iQ_{\alpha _i}\). Each panel shows nine densities with quantiles \(Q_{\bar \alpha }+a e_k\), including the barycenter at the violet midpoint \(a=0\), with \(a\) increasing from red to blue. The first mode is a common translation and the second changes the separation of the two components. Since every displayed quantile is increasing, these are valid probability laws in exact one-dimensional Wasserstein coordinates}{figure.11.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.10}{\ignorespaces \emph  {Principal components in linear OT coordinates for MNIST digit-zero histograms.} The left panel shows the Sinkhorn barycenter reference \(\gamma \). Each mode panel is a triptych obtained by pushing \(\gamma \) through \(x\DOTSB \mapstochar \rightarrow x+\bar  \xi (x)+a e_k(x)\) with a negative, zero, and positive coefficient \(a\). The displayed densities use white for zero displayed mass and black for high displayed mass; the underlying transport computations still use the original densities, where high pixel values carry the mass. The modes capture rotations, aspect-ratio changes, and stroke-thickness deformations in the tangent chart around the barycenter.}}{228}{figure.11.10}\protected@file@percent }
\newlabel{fig:linear-ot-mnist-pca}{{11.10}{228}{\emph {Principal components in linear OT coordinates for MNIST digit-zero histograms.} The left panel shows the Sinkhorn barycenter reference \(\gamma \). Each mode panel is a triptych obtained by pushing \(\gamma \) through \(x\mapsto x+\bar \xi (x)+a e_k(x)\) with a negative, zero, and positive coefficient \(a\). The displayed densities use white for zero displayed mass and black for high displayed mass; the underlying transport computations still use the original densities, where high pixel values carry the mass. The modes capture rotations, aspect-ratio changes, and stroke-thickness deformations in the tangent chart around the barycenter}{figure.11.10}{}}
