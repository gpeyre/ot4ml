\@writefile{lof}{\contentsline {figure}{\numberline {12.10}{\ignorespaces \emph  {Empirical inverse-OT losses approach a curved population geometry.} Panel (a) shows $n=10$ i.i.d.\ pairs from a fixed plan $\pi _0=(\mathrm  {Id},T)_\sharp \alpha $ generated by a nonlinear Brenier map $T$ for $A_0=-\mathrm  {Id}$. Panels (b,c) plot $t\DOTSB \mapstochar \rightarrow \mathcal  F_0(c_{A_t}\mid \mathaccent "0362{\pi }_n)$ for $n=10$ and $n=100$ on the same vertical scale. Each finite-sample curve is convex and polyhedral; increasing $n$ resolves progressively more affine pieces around the generating parameter $t=0$.}}{261}{figure.12.10}\protected@file@percent }
\newlabel{fig:inverse-ot-gap-loss}{{12.10}{261}{\emph {Empirical inverse-OT losses approach a curved population geometry.} Panel (a) shows $n=10$ i.i.d.\ pairs from a fixed plan $\pi _0=(\Id ,T)_\sharp \alpha $ generated by a nonlinear Brenier map $T$ for $A_0=-\Id $. Panels (b,c) plot $t\mapsto \mathcal F_0(c_{A_t}\mid \widehat \pi _n)$ for $n=10$ and $n=100$ on the same vertical scale. Each finite-sample curve is convex and polyhedral; increasing $n$ resolves progressively more affine pieces around the generating parameter $t=0$}{figure.12.10}{}}
