\@writefile{lof}{\contentsline {figure}{\numberline {16.12}{\ignorespaces \emph  {One-dimensional Gaussian Wasserstein gradient flows in the Euclidean parameter half-plane $(m,\sigma )$.} From left to right, the panels show relative entropy, squared Wasserstein distance, the debiased Sinkhorn divergence with $\varepsilon =1.2$, and relative Fisher information. The same $48$ initial parameters are marked in blue; the trajectories progress through violet toward the common target $(\bar  m,\bar  \sigma )$ in red. Each background uses its own level scale to reveal the geometry of the corresponding energy. The $\Wass  _2^2$ trajectories are straight rays, whereas the other functionals bend the evolution of the standard deviation.}}{415}{figure.16.12}\protected@file@percent }
\newlabel{fig:gradflow-gaussian-1d-energy-landscapes}{{16.12}{415}{\emph {One-dimensional Gaussian Wasserstein gradient flows in the Euclidean parameter half-plane $(m,\sigma )$.} From left to right, the panels show relative entropy, squared Wasserstein distance, the debiased Sinkhorn divergence with $\epsilon =1.2$, and relative Fisher information. The same $48$ initial parameters are marked in blue; the trajectories progress through violet toward the common target $(\bar m,\bar \sigma )$ in red. Each background uses its own level scale to reveal the geometry of the corresponding energy. The $\Wass _2^2$ trajectories are straight rays, whereas the other functionals bend the evolution of the standard deviation}{figure.16.12}{}}
