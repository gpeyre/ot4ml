\@writefile{lof}{\contentsline {figure}{\numberline {16.2}{\ignorespaces \emph  {One-dimensional diffusion bridge for a Gaussian-mixture data law.} The forward path $Z_t=(1-t)X+tY$ smooths the red data density toward a blue Gaussian endpoint. Reversing the probability-flow ODE transports a denser set of blue noise samples back toward the data modes, making the splitting of trajectories across mixture components visible.}}{391}{figure.16.2}\protected@file@percent }
\newlabel{fig:generative-diffusion-1d-forward-backward}{{16.2}{391}{\emph {One-dimensional diffusion bridge for a Gaussian-mixture data law.} The forward path $Z_t=(1-t)X+tY$ smooths the red data density toward a blue Gaussian endpoint. Reversing the probability-flow ODE transports a denser set of blue noise samples back toward the data modes, making the splitting of trajectories across mixture components visible}{figure.16.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16.3}{\ignorespaces \emph  {Two-dimensional noising paths from three Dirac masses to a single Gaussian.} The top row shows the linear interpolation $Z_t=(1-t)X+tY$, whose component centers move linearly toward the origin and whose covariance grows like $(t\sigma )^2\mathrm  {Id}$. The bottom row uses the variance-preserving Ornstein--Uhlenbeck coefficients $a_\tau =e^{-\tau }$ and $b_\tau =\sqrt  {1-e^{-2\tau }}$, reparametrized by $\tau =-\qopname  \relax o{log}\qopname  \relax o{cos}(\pi t/2)$ so that $a_t=\qopname  \relax o{cos}(\pi t/2)$ and $b_t=\qopname  \relax o{sin}(\pi t/2)$. It has the same endpoints but a different speed of contraction and noising.}}{391}{figure.16.3}\protected@file@percent }
\newlabel{fig:generative-diffusion-2d-forward-backward}{{16.3}{391}{\emph {Two-dimensional noising paths from three Dirac masses to a single Gaussian.} The top row shows the linear interpolation $Z_t=(1-t)X+tY$, whose component centers move linearly toward the origin and whose covariance grows like $(t\sigma )^2\Id $. The bottom row uses the variance-preserving Ornstein--Uhlenbeck coefficients $a_\tau =e^{-\tau }$ and $b_\tau =\sqrt {1-e^{-2\tau }}$, reparametrized by $\tau =-\log \cos (\pi t/2)$ so that $a_t=\cos (\pi t/2)$ and $b_t=\sin (\pi t/2)$. It has the same endpoints but a different speed of contraction and noising}{figure.16.3}{}}
