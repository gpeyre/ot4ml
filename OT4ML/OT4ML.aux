\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces \emph  {One-dimensional assignments for convex and concave costs.} The same ordered source and target clouds are matched with $c_p(x,y)=|x-y|^p$. For the convex quadratic cost, equal ranks are matched and the segments do not cross. For the concave cost, the optimum instead creates long crossing exchanges governed by the alternating-chain structure.}}{3}{figure.1.1}\protected@file@percent }
\newlabel{fig:matching-1d-convex-concave-costs}{{1.1}{3}{\emph {One-dimensional assignments for convex and concave costs.} The same ordered source and target clouds are matched with $c_p(x,y)=|x-y|^p$. For the convex quadratic cost, equal ranks are matched and the segments do not cross. For the concave cost, the optimum instead creates long crossing exchanges governed by the alternating-chain structure}{figure.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces \emph  {One-dimensional optimal matching by quantile sorting.} The red and blue curves are smooth laws used to generate equal-weight empirical measures; the dots are inverse-CDF samples at common quantile levels. The monotone assignment connects equal ranks, both for two Gaussian mixtures and for the transport from one central Gaussian toward a three-mode target law.}}{3}{figure.1.2}\protected@file@percent }
\newlabel{fig:matching-1d-quantile-assignment}{{1.2}{3}{\emph {One-dimensional optimal matching by quantile sorting.} The red and blue curves are smooth laws used to generate equal-weight empirical measures; the dots are inverse-CDF samples at common quantile levels. The monotone assignment connects equal ranks, both for two Gaussian mixtures and for the transport from one central Gaussian toward a three-mode target law}{figure.1.2}{}}
