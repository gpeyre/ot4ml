\@writefile{lof}{\contentsline {figure}{\numberline {15.9}{\ignorespaces \emph  {Multi-species entropy flow under the shared-density constraint $\DOTSI \sumop \slimits@ _i\rho _i=1$ on the periodic interval.} Each row is a time snapshot of the stacked densities, with the species shown as colored bands and time increasing from top to bottom. For a constant total density, the pressure in\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq-multispecies-modified-heat}\unskip \@@italiccorr )}} is constant, so each component follows the heat equation while the sum of the bands remains exactly flat.}}{346}{figure.15.9}\protected@file@percent }
