\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces \emph  {Dual weights control Laguerre cell masses in the semi-discrete quadratic problem.} The same blue target sites and red Gaussian source density are used in all panels; only the highlighted violet weight is changed. The dotted violet outline is the balanced cell. If the highlighted cell has too little source mass, then $\mathrm  {b}_j-\alpha (\mathbb  {L}_j(\mathrm  {g}))>0$ and the ascent update increases the weight, expanding the cell outward. If it has too much mass, the update decreases the weight, shrinking it inward. At balance, the cell mass matches the prescribed target mass and the first-order update vanishes.}}{75}{figure.5.2}\protected@file@percent }
\newlabel{fig:semidiscrete-weight-gradient-cells}{{5.2}{75}{\emph {Dual weights control Laguerre cell masses in the semi-discrete quadratic problem.} The same blue target sites and red Gaussian source density are used in all panels; only the highlighted violet weight is changed. The dotted violet outline is the balanced cell. If the highlighted cell has too little source mass, then $\b _j-\al (\Laguerre _j(\gD ))>0$ and the ascent update increases the weight, expanding the cell outward. If it has too much mass, the update decreases the weight, shrinking it inward. At balance, the cell mass matches the prescribed target mass and the first-order update vanishes}{figure.5.2}{}}
