\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces \emph  {Discrete Kantorovich dual potentials for the quadratic cost $C_{i,j}=|x_i-y_j|^2$.} In each panel the upper strip shows the fixed source histogram in red and the target histogram in blue: a balanced bimodal target, a more strongly shifted target, and a three-component mixture. The lower strip shows an optimal pair of dual vectors $(\mathrm  {f},\mathrm  {g})$, with gauge chosen so that $\langle \mathrm  {f},\,\mathrm  {a}\rangle =0$. Complementary slackness states that mass can be transported only through entries where $\mathrm  {f}_i+\mathrm  {g}_j=C_{i,j}$.}}{65}{figure.4.1}\protected@file@percent }
