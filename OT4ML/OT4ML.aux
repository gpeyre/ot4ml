\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces \emph  {Discrete Kantorovich dual potentials for the quadratic cost $\mathrm  {C}_{i,j}=|x_i-y_j|^2$.} In each panel the upper strip shows the fixed source histogram in red and the target histogram in blue: a balanced bimodal target, a more strongly shifted target, and a three-component mixture. The lower strip shows an optimal pair of dual vectors $(\mathrm  {f},\mathrm  {g})$, with gauge chosen so that $\langle \mathrm  {f},\,\mathrm  {a}\rangle =0$. Complementary slackness states that mass can be transported only through entries where $\mathrm  {f}_i+\mathrm  {g}_j=\mathrm  {C}_{i,j}$.}}{85}{figure.5.1}\protected@file@percent }
\newlabel{fig:dual-kantorovich-discrete-potentials}{{5.1}{85}{\emph {Discrete Kantorovich dual potentials for the quadratic cost $\C _{i,j}=|x_i-y_j|^2$.} In each panel the upper strip shows the fixed source histogram in red and the target histogram in blue: a balanced bimodal target, a more strongly shifted target, and a three-component mixture. The lower strip shows an optimal pair of dual vectors $(\fD ,\gD )$, with gauge chosen so that $\dotp {\fD }{\a }=0$. Complementary slackness states that mass can be transported only through entries where $\fD _i+\gD _j=\C _{i,j}$}{figure.5.1}{}}
