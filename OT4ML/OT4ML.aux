\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces \emph  {Discrete $c$-transform as a lower envelope for costs $c_p(x,y)=|x-y|^p$.} The red circles are four source atoms $x_i$ with potential values $\mathrm  {f}_i$; the gray curves are the translated functions $y\DOTSB \mapstochar \rightarrow c_p(x_i,y)-\mathrm  {f}_i$; the colored curve is their lower envelope $\mathrm  {f}^c(y)=\qopname  \relax m{min}_i c_p(x_i,y)-\mathrm  {f}_i$. This is the semi-discrete situation where $\mathcal  {X}$ is finite, equivalently the source measure $\alpha $ is discrete; Chapter\nobreakspace  {}\ref  {sec-semidiscr-w1} studies the complementary case where the eliminated potential is supported on finitely many target atoms.}}{89}{figure.5.4}\protected@file@percent }
\newlabel{fig:dual-c-transform-envelope}{{5.4}{89}{\emph {Discrete $c$-transform as a lower envelope for costs $c_p(x,y)=|x-y|^p$.} The red circles are four source atoms $x_i$ with potential values $\fD _i$; the gray curves are the translated functions $y\mapsto c_p(x_i,y)-\fD _i$; the colored curve is their lower envelope $\fD ^c(y)=\min _i c_p(x_i,y)-\fD _i$. This is the semi-discrete situation where $\X $ is finite, equivalently the source measure $\al $ is discrete; Chapter~\ref {sec-semidiscr-w1} studies the complementary case where the eliminated potential is supported on finitely many target atoms}{figure.5.4}{}}
