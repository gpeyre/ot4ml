\citation{2017-Genevay-AutoDiff}
\@writefile{lof}{\contentsline {figure}{\numberline {16.5}{\ignorespaces \emph  {Effect of the interpolant on exact reverse-flow trajectories.} All panels use the same three-Dirac target and the same Gaussian endpoint. The linear bridge $a_t=1-t$, $b_t=t$ produces almost radial curves. The variance-preserving OU bridge $a_\tau =e^{-\tau }$, $b_\tau =\sqrt  {1-e^{-2\tau }}$ changes the relative speed of contraction and noising. The overshooting bridge $a_t=(1-t)(1-2t)$, $b_t=t$ is not a time reparameterization of either one and produces a more pronounced bending of the reverse trajectories.}}{394}{figure.16.5}\protected@file@percent }
\newlabel{fig:generative-diffusion-schedule-comparison}{{16.5}{394}{\emph {Effect of the interpolant on exact reverse-flow trajectories.} All panels use the same three-Dirac target and the same Gaussian endpoint. The linear bridge $a_t=1-t$, $b_t=t$ produces almost radial curves. The variance-preserving OU bridge $a_\tau =e^{-\tau }$, $b_\tau =\sqrt {1-e^{-2\tau }}$ changes the relative speed of contraction and noising. The overshooting bridge $a_t=(1-t)(1-2t)$, $b_t=t$ is not a time reparameterization of either one and produces a more pronounced bending of the reverse trajectories}{figure.16.5}{}}
