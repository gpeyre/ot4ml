\@writefile{lof}{\contentsline {figure}{\numberline {12.6}{\ignorespaces \emph  {Capacity-constrained entropic OT between two one-dimensional Gaussian-mixture histograms.} Each matrix solves\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq-entropic-capacity-constrained-ot}\unskip \@@italiccorr )}} with the same marginals and the same squared-distance cost. The left panel is the unconstrained entropic OT solution, corresponding to the density-ratio cap $\overline  {\mathrm  {P}}_{i,j}=+\infty $. The other panels impose $\overline  {\mathrm  {P}}_{i,j}=u a_i b_j$. The red side strip is the source marginal and the blue top strip is the target marginal. As the capacity decreases, more entries saturate and the coupling is forced to spread.}}{256}{figure.12.6}\protected@file@percent }
\newlabel{fig:capacity-constrained-ot-1d}{{12.6}{256}{\emph {Capacity-constrained entropic OT between two one-dimensional Gaussian-mixture histograms.} Each matrix solves~\eqref {eq-entropic-capacity-constrained-ot} with the same marginals and the same squared-distance cost. The left panel is the unconstrained entropic OT solution, corresponding to the density-ratio cap $\overline {\P }_{i,j}=+\infty $. The other panels impose $\overline {\P }_{i,j}=u a_i b_j$. The red side strip is the source marginal and the blue top strip is the target marginal. As the capacity decreases, more entries saturate and the coupling is forced to spread}{figure.12.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.7}{\ignorespaces \emph  {Capacity-constrained local self-couplings on a two-dimensional empirical Gaussian mixture.} The source and target are the same semi-regular uniform empirical measure on $n$ atoms, but the diagonal is removed to avoid the trivial identity plan and reveal the local graph selected by the capped problem. Each panel solves\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq-entropic-capacity-constrained-ot}\unskip \@@italiccorr )}} with the off-diagonal cap $\overline  {\mathrm  {P}}_{i,j}=1/(qn)$, equivalently $\mathrm  {P}_{i,j}/a_i\leqslant 1/q$ since $a_i=1/n$. The three panels therefore impose at least one, three and five outgoing connections per source atom; increasing $q$ forces the local matching to spread over more neighbors.}}{257}{figure.12.7}\protected@file@percent }
\newlabel{fig:capacity-constrained-ot-2d}{{12.7}{257}{\emph {Capacity-constrained local self-couplings on a two-dimensional empirical Gaussian mixture.} The source and target are the same semi-regular uniform empirical measure on $n$ atoms, but the diagonal is removed to avoid the trivial identity plan and reveal the local graph selected by the capped problem. Each panel solves~\eqref {eq-entropic-capacity-constrained-ot} with the off-diagonal cap $\overline {\P }_{i,j}=1/(qn)$, equivalently $\P _{i,j}/a_i\leq 1/q$ since $a_i=1/n$. The three panels therefore impose at least one, three and five outgoing connections per source atom; increasing $q$ forces the local matching to spread over more neighbors}{figure.12.7}{}}
