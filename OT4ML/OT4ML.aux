\@writefile{lof}{\contentsline {figure}{\numberline {15.15}{\ignorespaces \emph  {Balanced and unbalanced gradient flows of $\KL  (\alpha |\beta )$ for one-dimensional Gaussian mixtures.} In each panel the colored density stacks correspond to five increasing times, from red to blue, and the faint gray curve repeated on each row is the target mixture $\beta $. The balanced Wasserstein flow is the conservative Fokker--Planck equation, so mass must move through the low-density region between modes. The $\WFR  _\kappa $ flow adds the birth--death reaction term in\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq-wfr-kl-flow}\unskip \@@italiccorr )}}; it attenuates overrepresented regions and creates missing mass near target modes, reaching the target shape much faster.}}{378}{figure.15.15}\protected@file@percent }
\newlabel{fig:gradflow-wfr-unbalanced-flow}{{15.15}{378}{\emph {Balanced and unbalanced gradient flows of $\KL (\alpha |\beta )$ for one-dimensional Gaussian mixtures.} In each panel the colored density stacks correspond to five increasing times, from red to blue, and the faint gray curve repeated on each row is the target mixture $\beta $. The balanced Wasserstein flow is the conservative Fokker--Planck equation, so mass must move through the low-density region between modes. The $\WFR _\kappa $ flow adds the birth--death reaction term in~\eqref {eq-wfr-kl-flow}; it attenuates overrepresented regions and creates missing mass near target modes, reaching the target shape much faster}{figure.15.15}{}}
