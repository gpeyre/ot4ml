\@writefile{lof}{\contentsline {figure}{\numberline {2.9}{\ignorespaces \emph  {Intrinsic McCann interpolation in the Poincar\'e disk.} Here \(\mathcal  X=\{x\in \mathbb  {R}^2:|\!| x |\!|<1\}\) and \(d_{\mathcal  X}(x,y)=\operatorname  {arcosh}\!\left (1+2|\!| x-y |\!|^2/((1-|\!| x |\!|^2)(1-|\!| y |\!|^2))\right )\). The black circle is the ideal boundary, the faint grid is intrinsic, and the thin violet curves are minimizing geodesics; the colored points show the interpolation at \(t=0,1/4,1/2,3/4,1\).}}{26}{figure.2.9}\protected@file@percent }
\newlabel{fig:monge-hyperbolic-mccann-interpolation}{{2.9}{26}{\emph {Intrinsic McCann interpolation in the Poincar\'e disk.} Here \(\mathcal X=\{x\in \RR ^2:\norm {x}<1\}\) and \(d_{\mathcal X}(x,y)=\operatorname {arcosh}\!\left (1+2\norm {x-y}^2/((1-\norm {x}^2)(1-\norm {y}^2))\right )\). The black circle is the ideal boundary, the faint grid is intrinsic, and the thin violet curves are minimizing geodesics; the colored points show the interpolation at \(t=0,1/4,1/2,3/4,1\)}{figure.2.9}{}}
