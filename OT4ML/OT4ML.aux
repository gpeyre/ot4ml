\@writefile{lof}{\contentsline {figure}{\numberline {10.4}{\ignorespaces \emph  {Positive-feature sketches of a Sinkhorn plan.} The top row shows entropic couplings between one-dimensional Gaussian mixtures. The bottom row displays the entries \(-\varepsilon \qopname  \relax o{log}(K_r)_{i,j}\) with black level sets, compared with the exact quadratic cost \(|x_i-y_j|^2\) in the first column. Rank \(40\) remains close to the dense computation, while ranks \(10\) and \(3\) preserve the marginals but increasingly blur the transport geometry. Gaussian quadrature is used for reproducibility; random features use the same positive factorization.}}{200}{figure.10.4}\protected@file@percent }
\newlabel{fig:sinkhorn-positive-feature-sketching}{{10.4}{200}{\emph {Positive-feature sketches of a Sinkhorn plan.} The top row shows entropic couplings between one-dimensional Gaussian mixtures. The bottom row displays the entries \(-\epsilon \log (K_r)_{i,j}\) with black level sets, compared with the exact quadratic cost \(|x_i-y_j|^2\) in the first column. Rank \(40\) remains close to the dense computation, while ranks \(10\) and \(3\) preserve the marginals but increasingly blur the transport geometry. Gaussian quadrature is used for reproducibility; random features use the same positive factorization}{figure.10.4}{}}
