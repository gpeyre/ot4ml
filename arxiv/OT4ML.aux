\@writefile{lof}{\contentsline {figure}{\numberline {8.6}{\ignorespaces \emph  {A doubly positive kernel that is not completely positive.} The periodic kernel \(k_\lambda (t)=\lambda +\qopname  \relax o{cos}^2(t/2)\), with \(\lambda =1/20\), is positive semidefinite and pointwise positive. On five equally spaced points, its Gram matrix is entrywise positive and PSD, but the Horn copositive certificate gives \(\langle H,K\rangle <0\), so this finite restriction is not completely positive and cannot admit a nonnegative Gram factorization.}}{173}{figure.8.6}\protected@file@percent }
\newlabel{fig:sinkhorn-doubly-positive-counterexample}{{8.6}{173}{\emph {A doubly positive kernel that is not completely positive.} The periodic kernel \(k_\lambda (t)=\lambda +\cos ^2(t/2)\), with \(\lambda =1/20\), is positive semidefinite and pointwise positive. On five equally spaced points, its Gram matrix is entrywise positive and PSD, but the Horn copositive certificate gives \(\langle H,K\rangle <0\), so this finite restriction is not completely positive and cannot admit a nonnegative Gram factorization}{figure.8.6}{}}
