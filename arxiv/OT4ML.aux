\@writefile{lof}{\contentsline {figure}{\numberline {9.9}{\ignorespaces \emph  {One-dimensional linear OT PCA for synthetic two-Gaussian mixtures.} The exact empirical Wasserstein barycenter has quantile \(Q_{\bar  \alpha }=N^{-1}\DOTSI \sumop \slimits@ _iQ_{\alpha _i}\). Each panel shows nine densities with quantiles \(Q_{\bar  \alpha }+a e_k\), including the barycenter at the violet midpoint \(a=0\), with \(a\) increasing from red to blue. The first mode is a common translation and the second changes the separation of the two components. Since every displayed quantile is increasing, these are valid probability laws in exact one-dimensional Wasserstein coordinates.}}{204}{figure.9.9}\protected@file@percent }
\newlabel{fig:linear-ot-1d-pca}{{9.9}{204}{\emph {One-dimensional linear OT PCA for synthetic two-Gaussian mixtures.} The exact empirical Wasserstein barycenter has quantile \(Q_{\bar \alpha }=N^{-1}\sum _iQ_{\alpha _i}\). Each panel shows nine densities with quantiles \(Q_{\bar \alpha }+a e_k\), including the barycenter at the violet midpoint \(a=0\), with \(a\) increasing from red to blue. The first mode is a common translation and the second changes the separation of the two components. Since every displayed quantile is increasing, these are valid probability laws in exact one-dimensional Wasserstein coordinates}{figure.9.9}{}}
