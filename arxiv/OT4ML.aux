\@writefile{lof}{\contentsline {figure}{\numberline {12.1}{\ignorespaces \emph  {One-dimensional Benamou--Brenier primal and dual solutions.} The endpoints are Gaussian mixtures and the solution is computed from monotone quantile interpolation. The left and middle panels show the primal density and the momentum density $m_t=\rho _t v_t$. The right panel shows the dual Hamilton--Jacobi potential, normalized up to an additive constant. Along the active transported mass, the notebook checks the primal--dual identities $m_t=\rho _t\partial _x\varphi _t/2$ and $\partial _t\varphi _t+|\partial _x\varphi _t|^2/4=0$.}}{268}{figure.12.1}\protected@file@percent }
\newlabel{fig:dynamic-benamou-brenier-duality}{{12.1}{268}{\emph {One-dimensional Benamou--Brenier primal and dual solutions.} The endpoints are Gaussian mixtures and the solution is computed from monotone quantile interpolation. The left and middle panels show the primal density and the momentum density $m_t=\rho _t v_t$. The right panel shows the dual Hamilton--Jacobi potential, normalized up to an additive constant. Along the active transported mass, the notebook checks the primal--dual identities $m_t=\rho _t\partial _x\phi _t/2$ and $\partial _t\phi _t+|\partial _x\phi _t|^2/4=0$}{figure.12.1}{}}
