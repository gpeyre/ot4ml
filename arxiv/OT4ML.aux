\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces \emph  {KL-normalized Sinkhorn dual potentials for the same one-dimensional Gaussian-mixture histograms.} The bottom silhouettes show both the source histogram $\mathrm  {a}$ in red and the target histogram $\mathrm  {b}$ in blue. The red and blue curves are the logarithmic scalings $\mathrm  {f}_i^\varepsilon =\varepsilon \qopname  \relax o{log}u_i^\varepsilon $ and $\mathrm  {g}_j^\varepsilon =\varepsilon \qopname  \relax o{log}v_j^\varepsilon $, with gauge $\langle \mathrm  {f}^\varepsilon ,\,\mathrm  {a}\rangle =0$, computed from $\mathrm  {P}_{i,j}=u_i\,\mathrm  {a}_i\mathrm  {b}_j e^{-\mathrm  {C}_{i,j}/\varepsilon }\,v_j$. The squared Euclidean cost is normalized by its median positive entry, and all panels use the same axes. For $\varepsilon =0.010$ the curves are already close to the unregularized one-dimensional Kantorovich potentials; increasing $\varepsilon $ turns this hard $c$-transform geometry into smoother log-sum-exp potentials.}}{120}{figure.7.7}\protected@file@percent }
\newlabel{fig:sinkhorn-dual-potentials-epsilon}{{7.7}{120}{\emph {KL-normalized Sinkhorn dual potentials for the same one-dimensional Gaussian-mixture histograms.} The bottom silhouettes show both the source histogram $\a $ in red and the target histogram $\b $ in blue. The red and blue curves are the logarithmic scalings $\fD _i^\epsilon =\epsilon \log u_i^\epsilon $ and $\gD _j^\epsilon =\epsilon \log v_j^\epsilon $, with gauge $\dotp {\fD ^\epsilon }{\a }=0$, computed from $\P _{i,j}=u_i\,\a _i\b _j e^{-\C _{i,j}/\epsilon }\,v_j$. The squared Euclidean cost is normalized by its median positive entry, and all panels use the same axes. For $\epsilon =0.010$ the curves are already close to the unregularized one-dimensional Kantorovich potentials; increasing $\epsilon $ turns this hard $c$-transform geometry into smoother log-sum-exp potentials}{figure.7.7}{}}
