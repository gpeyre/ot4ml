\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces \emph  {Positive Markov kernels contract the three-state simplex and can simultaneously rotate its image.} Each colored polygon is $\mathrm  {K}_i^\ell \Sigma _3$: color progresses from red at $\ell =0$ to blue at $\ell =15$, and the star is the common stationary vector $\pi _i=\mathds  {1}_3/3$. The isotropic kernel $\mathrm  {K}_1$ preserves edge directions, $\mathrm  {K}_2$ rotates an essentially homothetic triangle, and the non-normal kernel $\mathrm  {K}_3$ both turns and strongly elongates the image because its two tangent modes contract at unequal rates. The red boundary contains zero coordinates and is only a geometric reference: positivity sends the first image into the simplex interior, where Hilbert contraction applies.}}{155}{figure.8.1}\protected@file@percent }
\newlabel{fig:sinkhorn-birkhoff-simplex-contraction}{{8.1}{155}{\emph {Positive Markov kernels contract the three-state simplex and can simultaneously rotate its image.} Each colored polygon is $\K _i^\ell \simplex _3$: color progresses from red at $\ell =0$ to blue at $\ell =15$, and the star is the common stationary vector $\pi _i=\ones _3/3$. The isotropic kernel $\K _1$ preserves edge directions, $\K _2$ rotates an essentially homothetic triangle, and the non-normal kernel $\K _3$ both turns and strongly elongates the image because its two tangent modes contract at unequal rates. The red boundary contains zero coordinates and is only a geometric reference: positivity sends the first image into the simplex interior, where Hilbert contraction applies}{figure.8.1}{}}
