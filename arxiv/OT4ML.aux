\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces \emph  {Optimal assignments between the same two point clouds for four powers of the Euclidean distance.} The source atoms are semi-regular samples in a central disk, while the target atoms are semi-regular samples on a thin annulus; this canonical geometry is reused in later coupling and regularization figures. The feasible set is unchanged, but changing $p$ changes the global organization of the permutation: the concave case $p=1/2$ penalizes long edges only sublinearly and therefore permits longer exchanges, whereas larger powers increasingly suppress the longest edges.}}{7}{figure.1.5}\protected@file@percent }
\newlabel{fig:matching-2d-cost-exponent}{{1.5}{7}{\emph {Optimal assignments between the same two point clouds for four powers of the Euclidean distance.} The source atoms are semi-regular samples in a central disk, while the target atoms are semi-regular samples on a thin annulus; this canonical geometry is reused in later coupling and regularization figures. The feasible set is unchanged, but changing $p$ changes the global organization of the permutation: the concave case $p=1/2$ penalizes long edges only sublinearly and therefore permits longer exchanges, whereas larger powers increasingly suppress the longest edges}{figure.1.5}{}}
